# CODEOWNERS file for Tikka
# This file defines who should be automatically requested for review
# based on the files changed in a pull request.
#
# Format: <file-pattern> <owner> [<owner> ...]
# Owners can be GitHub usernames (@username) or teams (@org/team-name)
#
# Reference: https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/about-code-owners

# Global fallback - all files
* @crackedstudio/maintainers

# Smart contracts (Rust)
contracts/** @crackedstudio/maintainers

# Oracle service (TypeScript/Node.js)
oracle/** @crackedstudio/maintainers

# GitHub configuration (workflows, templates, etc.)
.github/** @crackedstudio/maintainers

# Documentation
docs/** @crackedstudio/maintainers
*.md @crackedstudio/maintainers

# Deployment scripts
scripts/** @crackedstudio/maintainers

# CI/CD configuration
.github/workflows/** @crackedstudio/maintainers

# Root configuration files
Cargo.toml @crackedstudio/maintainers
Cargo.lock @crackedstudio/maintainers
package.json @crackedstudio/maintainers
package-lock.json @crackedstudio/maintainers
.env.example @crackedstudio/maintainers

# Dependency manifests — individual review for supply-chain changes
deny.toml @crackedstudio/maintainers
oracle/Dockerfile @crackedstudio/maintainers
